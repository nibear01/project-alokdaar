# Copy to server/.env and fill real values. NEVER commit .env.

# --- Database (Neon) ---
# Dashboard → Connection string → PostgreSQL
# Use the pooled connection for the app (ends with -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Optional: direct URL for migrations (unpooled, from Neon "Direct URL")
# DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- API ---
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS
CLIENT_URL=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
# Refresh cookie is set by POST /api/auth/login (httpOnly).
# In production CLIENT_URL must be HTTPS for cross-site cookies (sameSite=none).

# --- Cloudinary (Document Vault) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Cloud Vision (OCR) ---
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# simpler API-key auth used by services/ocr.js (dev fallback kicks in when unset)
GOOGLE_VISION_API_KEY=
# Or inline JSON path used by the client library
# GCP_PROJECT_ID=

# --- SSLCommerz (Donations) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_SUCCESS_URL=http://localhost:4000/api/donations/ipn/success
SSLCOMMERZ_FAIL_URL=http://localhost:4000/api/donations/ipn/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:4000/api/donations/ipn/cancel

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- SMS (BulkSMSBD or Twilio) ---
SMS_PROVIDER=bulksmsbd
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google Gemini (AI assistant) ---
GEMINI_API_KEY=

# --- Google Maps (impact heatmap, optional — tile map is default) ---
GOOGLE_MAPS_API_KEY=

# --- Google Calendar (interviews) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- App ---
APP_NAME=Alokdaar
APP_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:5173
